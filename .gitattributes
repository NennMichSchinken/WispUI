# Normalize line endings: LF in the repository, native in the working copy.
* text=auto

# Explicit text types
*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.json    text
*.md      text
*.yml     text
*.gitattributes text
*.gitignore     text

# Binary assets — never touch these
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.dll binary
*.exe binary
